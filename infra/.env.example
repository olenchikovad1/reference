# Стенд. Копируется в infra/.env. Пароли здесь настоящие и это нормально:
# стенд локальный, наружу не смотрит (решение 0003).
POSTGRES_USER=reference
POSTGRES_PASSWORD=reference
POSTGRES_DB=reference
POSTGRES_PORT=5433

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# 9000 и 9001 заняты стендом платформы (platform-storage), поэтому 9010/9011
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011

S3_BUCKET=reference

RABBITMQ_PORT=5673
RABBITMQ_UI_PORT=15673

API_PORT=8010
WEB_PORT=5183

# Куда на хозяйской машине положены исходники изделий. Подключается томом
# только на чтение: сервис их читает, но не переписывает.
FILES_HOST_PATH=./stand/files

# Реестр пакетов платформы. Виден из контейнера как хозяйская машина:
# Verdaccio платформы слушает 127.0.0.1:4873 (решение 0006).
PLATFORM_NPM_REGISTRY=http://host.docker.internal:4873

# Туннель к Cosmic PLM для scripts/cosmic/query.py. Cosmic во внутренней сети
# офиса; из дома — через sandbox. Адреса в репозиторий не кладутся: значения
# в ~/.claude/infra_ssh_hosts.md (sandbox — через кого, plm — где база).
# Пример: COSMIC_SSH=-p 22 логин@адрес-sandbox, COSMIC_DB=адрес-plm:5432
COSMIC_SSH=
COSMIC_DB=
