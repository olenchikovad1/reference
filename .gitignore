# Секреты стенда. По решению 0003 учётки лежат открытым текстом в .env,
# но в репозиторий не попадают: пример рядом заполнен рабочими значениями
# локального стенда, поэтому копирование .env.example и есть вся настройка.
.env
*.env

# Том стенда в git (решение 0012): кадры, принты, эталоны — на них стоят
# проверки. Вне git только то, что стенду не нужно или скачивается само:
# исходники моделей VStitcher — сотни мегабайт на модель, код читает только
# путь (решение 0002); нейросети и словарь — их качает
# scripts/stand/fetch_models.py.
infra/stand/files/products/*/source/
infra/stand/files/models/
infra/stand/files/dictionaries/

# Сменный том кадров/принтов для prod (US-0025). Содержимое выкладывает
# scripts/stand/seed_garment_assets.py из стенда; в git только README.
infra/garment-assets/**
!infra/garment-assets/README.md


__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

node_modules/
dist/
*.tsbuildinfo

# Настройки редактора. Они принадлежат машине, а не проекту: у второго
# человека IDE другая, а конфликты в них решать нечем.
.idea/
.vscode/

# Решение владельца 30.09.2026: ключи и значения лежат в git открытым
# текстом, чтобы были у всей команды и на любой машине; репозиторий
# закрытый. Безопасностью займутся отдельным проходом позже.
!/api/.env
!/infra/.env
!/web/.env

# Личные настройки Claude Code — у каждого свои
/.claude/settings.local.json

# Машинные файлы выкатки (план 120): их кладёт установка в чистый клон из своего
# local/secrets/reference/ — в репозиторий «Референса» они не едут.
/deploy/sandbox.env
/deploy/hub.env
/infra/sandbox.env
/infra/hub.env
/infra/tunnel-keys/
