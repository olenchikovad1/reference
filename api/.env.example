# Сервис. Копируется в api/.env — правка одного файла, настройка закончена.
# Учётки лежат открытым текстом сознательно (решение 0003).

DATABASE_URL=postgresql+asyncpg://reference:reference@postgres:5432/reference

# Платформа: проверка подписи токена локально по JWKS, обращения к ядру нет.
PLATFORM_CORE_URL=http://core:8000
PLATFORM_JWKS_URL=http://core:8000/.well-known/jwks.json
PLATFORM_APP_CODE=reference

# Объектное хранилище: локально MinIO, на проде Yandex Object Storage.
# Сюда попадают кадры состояний и производные — то, что уходит в браузер.
S3_ENDPOINT=http://minio:9000
S3_BUCKET=reference
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=ru-central1

# Файловое пространство: исходники изделий (.bw из VStitcher, сотни мегабайт).
# Подключается томом, в базе хранится путь. В объектное хранилище не кладётся
# и в браузер не уходит никогда (решение 0002).
FILES_VOLUME_PATH=/srv/reference/files

AMQP_URL=amqp://guest:guest@rabbitmq:5672/
LOG_LEVEL=INFO
