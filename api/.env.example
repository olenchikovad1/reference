# Сервис. Копируется в api/.env — правка одного файла, настройка закончена.
# Учётки лежат открытым текстом сознательно (решение 0003).

DATABASE_URL=postgresql+asyncpg://reference:reference@postgres:5432/reference

# Платформа: проверка подписи токена локально по JWKS, обращения к ядру нет.
PLATFORM_CORE_URL=http://host.docker.internal:8100/platform/api/core
PLATFORM_JWKS_URL=http://host.docker.internal:8100/platform/api/core/jwks.json
PLATFORM_APP_CODE=reference

# Объектное хранилище: локально MinIO, на проде Yandex Object Storage.
# Сюда попадают кадры состояний и производные — то, что уходит в браузер.
S3_ENDPOINT=http://minio:9000
S3_BUCKET=reference
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=ru-central1

# Файловое пространство: исходники изделий (.bw из VStitcher, сотни мегабайт).
# Подключается томом, в базе хранится путь. В объектное хранилище не кладётся
# и в браузер не уходит никогда (решение 0002).
FILES_VOLUME_PATH=/srv/reference/files
# Описания изделий: тот же принцип, отдельный том только на чтение.
FIXTURES_PATH=/srv/reference/fixtures
# Модель эмбеддингов лежит в том же томе: тяжёлый файл, читается редко,
# в репозиторий не идёт.
EMBEDDING_MODEL_PATH=/srv/reference/files/models/clip-vit-base-patch32/vision_model_quantized.onnx
# Порог узнавания ТОЙ ЖЕ картинки. Измерен на наборе пар из prints.yaml:
# пять изменённых копий дали 0.915…0.992, ближайший чужой объект 0.896.
SIMILARITY_SAME=0.91
# Уровень «похожая» ВЫКЛЮЧЕН: на этих данных модель не отделяет тот же
# объект от той же категории, и окно срабатывало бы на каждом втором
# танке. Единица означает «никогда». Подробности в prints.yaml.
SIMILARITY_CLOSE=1.0

AMQP_URL=amqp://guest:guest@rabbitmq:5672/
LOG_LEVEL=INFO

# Платформа (план 072). Ядро — через шлюз стенда платформы на хозяйской
# машине (порт 8100), с надстройкой infra/compose.platform.yaml. Удостоверение pfc_…
# выдаёт платформа один раз при регистрации приложения; пусто — описание не
# публикуется, сервис работает (журнал старта говорит почему).
PLATFORM_CREDENTIAL=
