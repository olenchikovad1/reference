{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(docker:*)",
      "Bash(docker compose:*)",
      "Bash(py:*)",
      "Bash(python:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(alembic:*)",
      "Bash(uv:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(psql:*)",
      "Bash(curl:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(xxd:*)",
      "Bash(netstat:*)",
      "Bash(docker compose -f infra/compose.yaml:*)",
      "Bash(cd web:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm install:*)",
      "Bash(uv run:*)"
    ],
    "deny": [
      "Bash(docker compose down -v:*)",
      "Bash(docker volume rm:*)",
      "Bash(dropdb:*)",
      "Bash(git push --force origin master:*)",
      "Bash(git push -f origin master:*)",
      "Bash(git push --force-with-lease origin master:*)"
    ],
    "ask": [
      "Bash(alembic upgrade:*)",
      "Bash(alembic downgrade:*)",
      "Bash(uv run alembic:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -X utf8 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_claim_without_run.py\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "py -X utf8 \"$CLAUDE_PROJECT_DIR/.claude/hooks/require_skills.py\" --check",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -X utf8 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_commit_trailers.py\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "py -X utf8 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_shared_branch_push.py\"",
            "timeout": 20
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -X utf8 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_ui_boundary.py\"",
            "timeout": 20
          }
        ],
        "matcher": "Write|Edit|MultiEdit"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -X utf8 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_ui_boundary.py\" --changed",
            "timeout": 20
          }
        ],
        "matcher": "Bash|Write|Edit|MultiEdit"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -X utf8 \"$CLAUDE_PROJECT_DIR/.claude/hooks/push_task_branch.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -X utf8 \"$CLAUDE_PROJECT_DIR/.claude/hooks/require_skills.py\" --index",
            "timeout": 20
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ]
  }
}
