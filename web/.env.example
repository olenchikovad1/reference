# Фронтенд. Копируется в web/.env.
# Префикс отличается от боевого намеренно: так зашитый корень виден до выкладки.
VITE_APP_BASE=/reference/
VITE_API_BASE=/reference/api/

# Реестр пакетов платформы. Умолчания нет: npm понимает ${VAR}, но не понимает
# умолчаний, и молча делает из этого негодный адрес.
# Verdaccio платформы выставлен на 127.0.0.1:4873 хозяйской машины;
# из контейнера он виден как host.docker.internal (решение 0006).
PLATFORM_NPM_REGISTRY=http://host.docker.internal:4873
