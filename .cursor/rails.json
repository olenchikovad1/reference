    "backend": [
      "api/"
    ],
    "api": [
      "api/reference_api/api/",
      "api/reference_api/schemas/",
      "manifest.reference.yaml"
    ],
    "data": [
      "api/reference_api/models/",
      "api/reference_api/repositories/",
      "api/alembic/"
    ],
    "architecture": [
      "api/",
      "web/",
      "scripts/"
    ],
    "ops": [
      "infra/",
      "Dockerfile",
      ".github/workflows/",
      "deploy/",
      "installation.unit.toml"
    ],
    "docs": [
      "docs/",
      "README.md",
      "AGENTS.md",
      "scripts/README.md"
    ]
  }
}
